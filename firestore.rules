rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;

      // updatedAt の型チェックは serverTimestamp と相性が悪いため入れない
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.bestScore is number
        && request.resource.data.bestScore >= 0
        && request.resource.data.bestScore <= 999999
        && (!resource.exists || request.resource.data.bestScore >= resource.data.bestScore);
    }
  }
}
