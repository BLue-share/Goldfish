rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      // まずは確実に通るルール（自分の uid のみ書き込み可）
      // Console でこの内容を「公開」しないと反映されません
      allow create, update: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
